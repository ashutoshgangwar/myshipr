# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command(
  'node',
  ['-p',
   'require.resolve(
     "react-native/scripts/react_native_pods.rb",
     {paths: [process.argv[1]]},
   )', __dir__]
).strip

platform :ios, '15.5'
prepare_react_native_project!

# Enable the New Architecture to satisfy Fabric components in dependencies
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# ✅ REQUIRED for react-native-permissions (NEW WAY)
require_relative '../node_modules/react-native-permissions/scripts/setup'

target 'myshipr' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ✅ ENABLE ONLY THE PERMISSIONS YOU NEED
  setup_permissions([
    'Camera',
    'LocationWhenInUse',
    'LocationAlways',
    'PhotoLibrary',
    'Microphone',
  ])

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # REQUIRED for @maplibre/maplibre-react-native v10: it does NOT vendor the
    # native MapLibre SDK as a Pod. This helper (defined by the package's
    # podspec, evaluated during dependency resolution) adds the MapLibre Swift
    # Package to both the maplibre-react-native target and the app target.
    # Without it the iOS build fails with:
    #   @import MapLibre; module 'MapLibre' not found
    $MLRN.post_install(installer)

    # Add HERE SDK Swift files to myshipr target
    myshipr_target = installer.pods_project.targets.select { |target| target.name == 'myshipr' }.first
    if myshipr_target
      here_sdk_files = [
        'ios/myshipr/HERESDKManager.swift',
        'ios/myshipr/HERECredentials.swift',
        'ios/myshipr/HEREAutosuggestService.swift',
        'ios/myshipr/HERERoutingService.swift',
        'ios/myshipr/HEREGeocodingService.swift',
        'ios/myshipr/HEREMapView.swift',
        'ios/myshipr/HEREBridge.swift',
        'ios/myshipr/HEREBridge.m',
        'ios/myshipr/HereMapModule.m',
        'ios/myshipr/HereMapViewManager.m'
      ]
      
      here_sdk_files.each do |file_path|
        full_path = File.join(installer.sandbox.root.parent, file_path)
        if File.exist?(full_path)
          file_ref = installer.pods_project.new_file(full_path)
          myshipr_target.source_build_phase.add_file_reference(file_ref)
        end
      end
    end

    # If you have HERE SDK frameworks (heresdk.framework or similar),
    # copy them into the app bundle and add to the Xcode project.
    # Place frameworks under ios/Frameworks (create that folder) and
    # this post_install hook will add them automatically.
    frameworks_dir = File.join(installer.sandbox.root.parent, 'ios/Frameworks')
    if Dir.exist?(frameworks_dir)
      # Include both .framework and .xcframework so bundles like heresdk.xcframework are handled
      Dir.glob(File.join(frameworks_dir, '*.{framework,xcframework}')).each do |fw|
        next unless File.exist?(fw)
        file_ref = installer.pods_project.new_file(fw)
        # Link into Frameworks and also embed into the app bundle
        myshipr_target.frameworks_build_phase.add_file_reference(file_ref)

        # Ensure there's an Embed Frameworks copy-files phase and add the framework there
        embed_phase = myshipr_target.copy_files_build_phases.find { |phase| phase.name == 'Embed Frameworks' }
        unless embed_phase
          embed_phase = myshipr_target.new_copy_files_build_phase('Embed Frameworks')
          # Destination 10 == Frameworks
          embed_phase.dst_subfolder_spec = '10'
        end
        embed_phase.add_file_reference(file_ref)
      end
    end

    # Fix: non-modular-include-in-framework-module (react-native-maps & maplibre)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

        other_cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CFLAGS'] = "#{other_cflags} -Wno-error=return-type"

        other_cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{other_cxxflags} -Wno-error=return-type"
      end
    end
  end
end
