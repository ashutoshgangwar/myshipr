# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command(
  'node',
  ['-p',
   'require.resolve(
     "react-native/scripts/react_native_pods.rb",
     {paths: [process.argv[1]]},
   )', __dir__]
).strip

platform :ios, '15.5'
prepare_react_native_project!

# Enable the New Architecture to satisfy Fabric components in dependencies
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# ✅ REQUIRED for react-native-permissions (NEW WAY)
require_relative '../node_modules/react-native-permissions/scripts/setup'

target 'myshipr' do
  config = use_native_modules!

  # React Native Firebase (statically linked, i.e. no use_frameworks!) requires
  # the Firebase pods to expose clang module maps, because they `@import` each
  # other (e.g. FirebaseMessaging does `@import FirebaseCore`). Without module
  # maps the build fails with "Module 'FirebaseCore' not found".
  # Scoped to just the Firebase/Google subtree so the rest of the project
  # (React Native, HERE, MLKit, MapLibre) keeps its existing header style.
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'PromisesObjC', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ✅ ENABLE ONLY THE PERMISSIONS YOU NEED
  setup_permissions([
    'Camera',
    'LocationWhenInUse',
    'LocationAlways',
    'PhotoLibrary',
    'Microphone',
  ])

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # REQUIRED for @maplibre/maplibre-react-native v10: it does NOT vendor the
    # native MapLibre SDK as a Pod. This helper (defined by the package's
    # podspec, evaluated during dependency resolution) adds the MapLibre Swift
    # Package to both the maplibre-react-native target and the app target.
    # Without it the iOS build fails with:
    #   @import MapLibre; module 'MapLibre' not found
    $MLRN.post_install(installer)

    # ...but that helper attaches the MapLibre SPM product to BOTH the
    # maplibre-react-native pod target and the app target. Each attachment emits
    # its own SignatureCollection task, producing two files with the same
    # basename in different directories:
    #   <BuildProductsPath>/Release-iphoneos/MapLibre.xcframework-ios.signature
    #   <BuildProductsPath>/Release-iphoneos/maplibre-react-native/MapLibre.xcframework-ios.signature
    # The archive's Signatures/ folder is flat, so assembling it fails with:
    #   "MapLibre.xcframework-ios.signature" couldn't be copied to "Signatures"
    #   because an item with the same name already exists.
    # Only archives hit this; a plain build never assembles Signatures/.
    # The two files are byte-identical and the app target's copy is the one the
    # archive needs, so drop the pod target's redundant copy. SignatureCollection
    # runs at the top of the build graph, well before this phase.
    mlrn_target = installer.pods_project.targets.find { |t| t.name == 'maplibre-react-native' }
    if mlrn_target
      phase_name = '[CP-User] Remove duplicate MapLibre xcframework signature'
      unless mlrn_target.shell_script_build_phases.any? { |p| p.name == phase_name }
        phase = mlrn_target.new_shell_script_build_phase(phase_name)
        phase.shell_script = 'rm -f "${CONFIGURATION_BUILD_DIR}/MapLibre.xcframework-ios.signature"'
        phase.show_env_vars_in_log = '0'
      end
    end

    # Fix: non-modular-include-in-framework-module (react-native-maps & maplibre)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

        # Xcode 16+ / 26 enables "Explicitly Built Modules" by default. Its clang
        # dependency scanner runs BEFORE CocoaPods' "copy module map" build phase,
        # so it fails with:
        #   Clang dependency scanner failure: fatal error: module map file
        #   '.../Build/Products/Debug-iphoneos/FirebaseCoreInternal/FirebaseCoreInternal.modulemap' not found
        # and cascades into every "Search path ... not found". Reverting to implicit
        # modules (the behaviour CocoaPods expects) fixes it.
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

        other_cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CFLAGS'] = "#{other_cflags} -Wno-error=return-type"

        other_cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{other_cxxflags} -Wno-error=return-type"
      end
    end

    # The app ("myshipr") target lives in the user project, not the Pods project,
    # and it triggers the same explicit-modules scanner. Disable it there too.
    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next unless user_project
      user_project.native_targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
          config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
      user_project.save
    end
  end
end
